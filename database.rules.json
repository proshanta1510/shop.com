{
  "rules": {
    "shop": {
      ".read": "auth != null && (auth.token.email == 'আপনার-ইমেইল@gmail.com')",
      ".write": "auth != null && (auth.token.email == 'আপনার-ইমেইল@gmail.com')"
    },
    "catalog": {
      ".read": true,
      ".write": "auth != null && (auth.token.email == 'আপনার-ইমেইল@gmail.com')"
    },
    "orders": {
      ".read": "auth != null && (auth.token.email == 'আপনার-ইমেইল@gmail.com')",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChild('list')"
      }
    }
  }
}
